# Configuración de despliegue (copia a .env y rellena)
# Puerto HTTP de la app. Con HTTPS activado no puede ser 80 (lo usa Caddy).
PORT=8080
# HTTPS con Caddy (necesario para push y micrófono en el móvil). Descomenta las tres líneas:
#   NEXUS_DOMAIN: un dominio público que apunte a este servidor (certificado de Let's Encrypt), o
#   "localhost, 192.168.x.x" para la red local (certificado interno: hay que instalar su raíz en cada dispositivo).
#   HTTP_BIND=127.0.0.1 cierra el acceso sin cifrar desde fuera de este equipo.
#COMPOSE_PROFILES=https
#NEXUS_DOMAIN=nexus.tu-dominio.com
#HTTP_BIND=127.0.0.1
# Solo para migrar desde la versión anterior (perfil "legacy", ver docs/MIGRACION.md)
POSTGRES_DB=proyectazo_db
POSTGRES_USER=proyectazo_admin
POSTGRES_PASSWORD=
# Lista blanca de orígenes del frontend, separados por comas (evita "*")
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Usuario inicial del sistema (se crea solo si no existe ninguno).
# Si dejas la contraseña vacía o con menos de 8 caracteres, se genera una temporal y aparece en el log del contenedor nexus-app.
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=
GEMINI_API_KEY=
# Modelos de IA en orden de preferencia (si uno falla o se retira, se prueba el siguiente)
NEXUS_AI_MODELS=gemini-2.5-flash,gemini-flash-latest
# Jarvis (asistente conversacional). Proveedor: claude | local. Vacío = claude si hay ANTHROPIC_API_KEY, si no local
NEXUS_AI_PROVIDER=
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low
# Web Push (opcional). Si se dejan vacías, el servidor genera las claves VAPID una vez y las guarda en la BD.
# Fijarlas aquí permite rehacer la base de datos sin que los dispositivos tengan que volver a suscribirse.
NEXUS_VAPID_PUBLIC_KEY=
NEXUS_VAPID_PRIVATE_KEY=
NEXUS_PUSH_SUBJECT=mailto:tu_correo@ejemplo.com
# Cifra en reposo la clave privada VAPID y la contraseña de Gmail. Cualquier texto largo y aleatorio.
# Guárdala también fuera del servidor: sin ella, push y correo quedan desactivados hasta restaurarla.
NEXUS_SECRET_KEY=
# Copias de seguridad diarias de la base de datos (dentro del volumen de datos, carpeta backups/).
# Número de copias que se conservan; 0 las desactiva.
NEXUS_BACKUP_KEEP=14
