# Configuración de despliegue (copia a .env y rellena)
PORT=80
POSTGRES_DB=proyectazo_db
POSTGRES_USER=proyectazo_admin
# Obligatoria: docker compose no arranca sin ella
POSTGRES_PASSWORD=
# Lista blanca de orígenes del frontend, separados por comas (evita "*")
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Usuario inicial del sistema (se crea solo si no existe ninguno).
# Si dejas la contraseña vacía o con menos de 8 caracteres, se genera una temporal y aparece en el log del backend.
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=
GEMINI_API_KEY=
# Modelos de IA en orden de preferencia (si uno falla o se retira, se prueba el siguiente)
NEXUS_AI_MODELS=gemini-2.5-flash,gemini-flash-latest
# Jarvis (asistente conversacional). Proveedor: claude | local. Vacío = claude si hay ANTHROPIC_API_KEY, si no local
NEXUS_AI_PROVIDER=
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low
# Web Push (opcional). Si se dejan vacías, el backend genera las claves VAPID una vez y las guarda en la BD.
# Fijarlas aquí permite rehacer la base de datos sin que los dispositivos tengan que volver a suscribirse.
NEXUS_VAPID_PUBLIC_KEY=
NEXUS_VAPID_PRIVATE_KEY=
NEXUS_PUSH_SUBJECT=mailto:tu_correo@ejemplo.com
