FROM python:3.15-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir pydantic python-dotenv google-genai

# Create non-root user and data directory with correct permissions
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appuser /app

# Copy service script
COPY --chown=appuser:appuser nexus_service.py .
# Reglas del clasificador compartidas con el navegador
COPY --chown=appuser:appuser js/clasificador-reglas.js ./js/

USER appuser

EXPOSE 8002

ENV PORT=8002
ENV PYTHONUNBUFFERED=1

CMD ["python", "nexus_service.py"]
