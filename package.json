{
  "name": "nexus-orb-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Herramientas del frontend: Tailwind compilado, lint y comprobación de tipos",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.input.css -o assets/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.input.css -o assets/tailwind.css --watch",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint js --max-warnings 0"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "tailwindcss": "3.4.17",
    "typescript": "^7.0.2"
  }
}
