<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis: cada hora se reintenta enviar lo que quedó pendiente sin red -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_soltar_descripcion"
    android:initialLayout="@layout/widget_soltar"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:previewLayout="@layout/widget_soltar"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />